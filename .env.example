# Copy to .env.local and fill in. NEVER commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Tbilisi

# Supabase (EU region project). Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...     # server only, never NEXT_PUBLIC_

# SMS (Phase 5)
SMS_PROVIDER=fake                     # fake | smsoffice | ...
SMS_API_KEY=                          # server only
SMS_DEFAULT_SENDER=

# Email (transactional now with the fake provider; marketing in Phase 7)
EMAIL_PROVIDER=fake
EMAIL_API_KEY=                        # server only
EMAIL_WEBHOOK_SECRET=

# Payments (Phase 8)
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=

# Monitoring (Phase 6)
SENTRY_DSN=
