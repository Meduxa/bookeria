# Copy to .env.local and fill in. NEVER commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Tbilisi

# Supabase (EU region project). Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...     # server only, never NEXT_PUBLIC_

# SMS — fake until Phase 5: prints messages in the dev server window and writes .dev/sms-outbox.jsonl
# (refuses to run in production unless ALLOW_FAKE_SMS=1, e.g. for a staging demo)
SMS_PROVIDER=fake                     # fake | smsoffice | ...
SMS_API_KEY=                          # server only
SMS_DEFAULT_SENDER=

# Email: fake (prints to the dev window) or resend (https://resend.com, EU region)
EMAIL_PROVIDER=fake                   # fake | resend
EMAIL_API_KEY=                        # server only (Resend API key)
EMAIL_FROM=                           # e.g. Bookeria <no-reply@your-domain> — a domain verified in Resend
EMAIL_WEBHOOK_SECRET=

# Background jobs (SMS reminders and queue). Production: a long random value, also set in the
# host scheduler as "Authorization: Bearer <value>". Locally it may stay empty.
CRON_SECRET=

# Payments (Phase 8)
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=

# Error reports (Sentry, EU region). The DSN is public by design; leave empty to switch off.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
